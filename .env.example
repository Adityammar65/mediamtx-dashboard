MEDIAMTX_API_URL=http://mediamtx:9997
USE_MOCK=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_FILE_PATH=/var/log/mediamtx.log
NODE_EXPORTER_URL=http://127.0.0.1:9100

# JWT Authentication
# Admin username for dashboard login
AUTH_USERNAME=admin
# Admin password for dashboard login
AUTH_PASSWORD=admin
# JWT signing secret - generate a strong random string for production
JWT_SECRET=YOUR_RANDOM_SECRET_KEY_HERE
# JWT token expiration time in minutes (default: 8 hours)
JWT_EXPIRE_MINUTES=480
# Enable Secure cookie attribute (requires HTTPS)
JWT_SECURE_COOKIE=false